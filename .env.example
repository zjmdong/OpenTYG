# Browser-facing HTTPS origin, including the port when it is not 443.
PUBLIC_ORIGIN=https://opentyg.example.com

# Loopback is suitable for a reverse proxy running on this same host.
LAN_BIND_IP=127.0.0.1
APP_PORT=8080
APP_UID=10001
APP_GID=10001
NODE_IMAGE=node:24-alpine

# Compatibility with the current HTTP-only upstream.
TYG_ORIGIN=http://lxj.taoyuangu.com:80
UPSTREAM_ALLOWED_HOSTS=lxj.taoyuangu.com,uums.taoyuangu.com,sso.taoyuangu.com
ALLOW_INSECURE_UPSTREAM=1
LOG_QUIET=0
